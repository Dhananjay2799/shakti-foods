# Copy to .env.local for local development, and set the same variables in
# Vercel (Project → Settings → Environment Variables) for production.

# ─── Websites ────────────────────────────────────────────────────────────────
# Shakti Foods and Simpli Ecoware are two separate websites served by this one
# codebase. Emails, Stripe redirects and cart-recovery links use the site the
# order belongs to. Defaults shown; for local dev set NEXT_PUBLIC_BASE_URL to
# http://localhost:3000 (Ecoware is then reachable at /ecoware).
NEXT_PUBLIC_BASE_URL=https://shakti-foods.com
NEXT_PUBLIC_ECOWARE_URL=https://simpliecoware.vercel.app
NEXT_PUBLIC_SITE_URL=https://shakti-foods.com

# ─── Email (Resend) — REQUIRED for order confirmations ───────────────────────
# Without RESEND_API_KEY every customer email fails (checkout still succeeds).
RESEND_API_KEY=re_your_key_here
# Must use a domain verified in Resend (shaktifoodsus.com is verified).
ORDER_EMAIL_FROM=Shakti Foods <orders@shaktifoodsus.com>
# Optional per-site overrides. Ecoware defaults to "Simpli Ecoware <same
# address as ORDER_EMAIL_FROM>" until it has its own verified domain.
SHAKTI_ORDER_EMAIL_FROM=
ECOWARE_ORDER_EMAIL_FROM=
# Contact details shown in order emails (and used as reply-to).
# Shakti defaults to the email/phone in lib/site.js.
SHAKTI_SUPPORT_EMAIL=
ECOWARE_SUPPORT_EMAIL=
ECOWARE_SUPPORT_PHONE=

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here
STRIPE_AUTOMATIC_TAX=false

# ─── PayPal ──────────────────────────────────────────────────────────────────
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Admin, cron, shipping ───────────────────────────────────────────────────
# Comma-separated admin login emails.
ADMIN_EMAILS=
# Vercel Cron sends this as a Bearer token to /api/cron/cart-recovery, which
# also retries failed order confirmation emails once a day.
CRON_SECRET=
SHIPPO_API_TOKEN=

# ─── Subscriptions ───────────────────────────────────────────────────────────
SUBSCRIPTIONS_LIVE_ENABLED=false
NEXT_PUBLIC_SUBSCRIPTIONS_LIVE_ENABLED=false

# ─── Wholesale inquiry form (SMTP) ───────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
INQUIRY_TO=

# ─── Analytics ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
